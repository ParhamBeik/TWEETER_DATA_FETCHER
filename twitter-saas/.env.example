# Copy to .env and adjust. Never commit the filled-in .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Comma-separated. :5173 = vite dev server, :8080 = nginx frontend in compose.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Postgres (sole durable store)
POSTGRES_DB=twitter_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Fetch cadence (seconds) and per-run account cap
FETCH_LIVE_INTERVAL_SECONDS=600
FETCH_HISTORICAL_INTERVAL_SECONDS=21600
FETCH_SEARCH_INTERVAL_SECONDS=1800
FETCH_MAX_ACCOUNTS_PER_RUN=25

# Shared X session (operator-supplied). Alternative to `manage.py load_xsession --file`.
# X_SESSION_JSON={"cookies": {"auth_token": "...", "ct0": "..."}, "headers": {"authorization": "Bearer ...", "x-csrf-token": "..."}}
