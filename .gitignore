# Runtime data (gitignored)
data/

# Output directories - generated by diagnostic tools (co-located under tests/diagnostics/)
tests/diagnostics/probe_runs/
tests/diagnostics/sniffer_runs/
tests/diagnostics/graphql_logs/

# Generated knowledge graph (regenerate with `graphify update .`)
graphify-out/

# Legacy capture archive (superseded by v4 sniffer)
graphql_logs/

# Credentials (v1-v3) — live session tokens; never commit.
LEGACY/TWEETER DATA FETCHING 1.0/config.json
LEGACY/TWEETER DATA FETCHING 2.0/config.json
LEGACY/TWEETER DATA FETCHING 3.0/ADVANCED SEARCH/config.json
LEGACY/TWEETER DATA FETCHING 3.0/HISTORICAL DATA/config.json
LEGACY/TWEETER DATA FETCHING 3.0/LIVE DATA/config.json

# V4 config files (contain secrets)
src/shared/config/config.json
src/shared/config/config.json.backup

# Generated repomix context dumps (large; embed captured secrets)
**/repomix-output.md

.env

# Ignore all markdown and reference files in LEGACY
LEGACY/**/MARKDOWN FILES/
LEGACY/**/REFRENCES FILES/
LEGACY/**/*.md
LEGACY/**/*.txt

# Legacy runtime junk (logs, backups) — keep .py source tracked as an archive
LEGACY/**/logs/
LEGACY/**/*.bak
*.bak
