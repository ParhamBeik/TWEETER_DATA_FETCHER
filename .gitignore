# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Node
node_modules/
frontend/dist/

# IDE / OS
# NB: .github/ is deliberately NOT here. It was, grouped in with the editor
# dirs, which meant the CI workflow never reached GitHub and no push has ever
# been tested there -- the only runs on record are GitHub's own dependency
# graph job.
.claude/
.vscode/
.DS_Store

# Secrets and local runtime state
.env
*.sqlite3
backups/

# Test/build artifacts
.pytest_cache/
coverage/

# Local code graph (regenerated by `graphify update`)
graphify-out/

# Engine scratch output when a test builds a StorageManager without a temp root
backend/data/
