# Copy to .env and adjust. Never commit the filled-in .env.

# Django
# REQUIRED. Django refuses to boot on a placeholder or a key under 32 chars --
# the old placeholder was shipped verbatim in real .env files, which made every
# session cookie and DRF token forgeable by anyone with this repo. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated. :5173 = vite dev server, :8080 = nginx frontend in compose.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to 1 ONLY where TLS is terminated upstream (the production Caddy host).
# It marks session/CSRF cookies Secure and turns on HSTS; on a plain-HTTP
# deployment the browser would simply discard those cookies.
DJANGO_SECURE_SSL=0
# Required once the site is served over HTTPS: Django checks the browser's
# Origin header against this on every unsafe request, and an https:// origin
# never matches a bare hostname. Scheme included, comma-separated.
# e.g. CSRF_TRUSTED_ORIGINS=https://your.domain
CSRF_TRUSTED_ORIGINS=

# Postgres (sole durable store)
POSTGRES_DB=twitter_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Fetch cadence (seconds) and per-run account cap. Redis locks prevent
# overlapping cycles; the live scheduler rotates accounts within its rate budget.
# Archive completeness over live freshness: live/search share the slower
# 1800s cadence, historical ticks every 300s in small 1-account chunks (see
# fetching.tasks.backfill_historical_all) so one high-volume account
# can't blow the whole chunk's time budget and stall the watermark.
FETCH_LIVE_INTERVAL_SECONDS=1800
FETCH_HISTORICAL_INTERVAL_SECONDS=300
FETCH_HISTORICAL_CHUNK_SIZE=1
# Pages one account's archive walk may fetch per tick, and the number of
# requests it must leave in the shared UserTweets bucket for live polling.
FETCH_HISTORICAL_PAGES_PER_TICK=25
FETCH_HISTORICAL_QUOTA_FLOOR=20
# Fallback cadence for a search created without one; per-search cadence lives
# on the row. The dispatcher only checks who is due, so it ticks far faster.
FETCH_SEARCH_INTERVAL_SECONDS=1800
FETCH_SEARCH_DISPATCH_SECONDS=300
# Window used to measure each account's real posting rate.
FETCH_INTERVAL_SAMPLE_DAYS=30
FETCH_CYCLE_TIMEOUT_SECONDS=1800
FETCH_MAX_ACCOUNTS_PER_RUN=100
# How far back the archive walk is willing to go, as a storage ceiling rather
# than a technical limit. Lowering it strands accounts already marked as having
# reached the floor -- reopen them with `manage.py reopen_shallow_archives`.
FETCH_ARCHIVE_EARLIEST_DATE=2024-01-01
SEARCH_TWEET_TTL_DAYS=30
FETCH_RUN_RETENTION_DAYS=90
# Raw GraphQL pages get their own, much shorter clock: they are the bulk of the
# database and their usefulness decays far faster than a run record's.
# TEMPORARY: 3 while fetching.runner's raw_page_census measures what each run
# status actually costs. Restore to 30 once RAW_PAGE_KEEP_STATUSES is set --
# see the follow-up note in that module.
RAW_PAGE_RETENTION_DAYS=3
# Ceiling per purge run, so the first pass after a deploy cannot hold the
# control worker for however long a multi-GB backlog takes.
RAW_PAGE_PURGE_MAX_ROWS=200000
# Engagement snapshots. Matches the 90-day ceiling analytics clamps every
# window to, so nothing purgeable is reachable from any endpoint.
TWEET_METRIC_RETENTION_DAYS=90
TWEET_METRIC_PURGE_MAX_ROWS=500000

# Archived photos and video. MEDIA_ROOT is a compose volume in production and
# must never point at the fetcher scratch tree, which is deleted after each run.
# Left commented rather than blank: compose passes an empty value through as an
# empty string, which would resolve to the working directory.
# MEDIA_ROOT=/app/media
# Photos per archive_media tick, and how often that tick fires. Small on
# purpose: it shares the solo control worker with the search dispatcher.
MEDIA_ARCHIVE_BATCH=25
MEDIA_ARCHIVE_INTERVAL_SECONDS=120
# Open signup. New accounts are read-only; operating the fetcher and replacing
# the X session require staff, granted in /admin/.
ALLOW_REGISTRATION=1

# Production overlay (docker-compose.prod.yml) also needs:
# REDIS_PASSWORD=change-me
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=your.domain
# CORS_ALLOWED_ORIGINS=https://your.domain

# Shared X session (operator-supplied). Alternative to `manage.py load_xsession --file`.
# X_SESSION_JSON={"cookies": {"auth_token": "...", "ct0": "..."}, "headers": {"authorization": "Bearer ...", "x-csrf-token": "..."}}
