# Copy to .env and adjust. Never commit the filled-in .env.

# Django
# REQUIRED. Django refuses to boot on a placeholder or a key under 32 chars --
# the old placeholder was shipped verbatim in real .env files, which made every
# session cookie and DRF token forgeable by anyone with this repo. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated. :5173 = vite dev server, :8080 = nginx frontend in compose.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Postgres (sole durable store)
POSTGRES_DB=twitter_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Fetch cadence (seconds) and per-run account cap. Redis locks prevent
# overlapping cycles; the live scheduler rotates accounts within its rate budget.
# Archive completeness over live freshness: live/search share the slower
# 1800s cadence, historical ticks every 300s in small 1-account chunks (see
# apps.fetching.tasks.backfill_historical_all) so one high-volume account
# can't blow the whole chunk's time budget and stall the watermark.
FETCH_LIVE_INTERVAL_SECONDS=1800
FETCH_HISTORICAL_INTERVAL_SECONDS=300
FETCH_HISTORICAL_CHUNK_SIZE=1
FETCH_SEARCH_INTERVAL_SECONDS=1800
FETCH_CYCLE_TIMEOUT_SECONDS=1800
FETCH_MAX_ACCOUNTS_PER_RUN=100
SEARCH_TWEET_TTL_DAYS=30
FETCH_RUN_RETENTION_DAYS=90
ALLOW_REGISTRATION=0

# Production overlay (docker-compose.prod.yml) also needs:
# REDIS_PASSWORD=change-me
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=your.domain
# CORS_ALLOWED_ORIGINS=https://your.domain

# Shared X session (operator-supplied). Alternative to `manage.py load_xsession --file`.
# X_SESSION_JSON={"cookies": {"auth_token": "...", "ct0": "..."}, "headers": {"authorization": "Bearer ...", "x-csrf-token": "..."}}
